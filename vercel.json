{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "proxy": {
    "entrypoint": "proxy.ts",
    "matcher": [
      "/",
      "/contact/:path*",
      "/faq/:path*",
      "/about",
      "/our-story",
      "/team",
      "/work",
      "/careers/:path*",
      "/services/:path*",
      "/seo/:path*",
      "/news/:path*",
      "/insights/:path*",
      "/case-studies/:path*",
      "/sitemap",
      "/privacy-policy",
      "/cookie-policy",
      "/terms",
      "/wip"
    ]
  },
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "{*.html,faq/*.html,api/sitemap-template.html,_localized/**/*.html}"
    }
  },
  "headers": [
    { "source": "/faq", "has": [{ "type": "query", "key": "q", "value": ".+" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/faq/:path*", "has": [{ "type": "query", "key": "q", "value": ".+" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] }
  ],
  "redirects": [
    { "source": "/:locale(pt|es|el|ru)/services/seo-strategy", "destination": "/:locale/wip?for=seo-strategy", "permanent": false },
    { "source": "/:locale(pt|es|el|ru|he)/faq", "destination": "/faq", "permanent": true },
    { "source": "/:locale(pt|es|el|ru|he)/faq/:path*", "destination": "/faq/:path*", "permanent": true },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "studio17.world" }],
      "destination": "https://www.studio17.world/:path*",
      "permanent": true
    },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/article", "destination": "/news", "permanent": true },
    { "source": "/website-services", "destination": "/services/website", "permanent": true },
    { "source": "/services/website-developments", "destination": "/services/website-development", "permanent": true },
    { "source": "/website-development", "destination": "/services/website-development", "permanent": true },
    { "source": "/website-pricing", "destination": "/services/website-pricing", "permanent": true },
    { "source": "/free-website", "destination": "/services/free-website", "permanent": true },
    { "source": "/localization-and-translation", "destination": "/services/localization-and-translation", "permanent": true },
    { "source": "/social-media", "destination": "/services/social-media", "permanent": true },
    { "source": "/social-media-pricing", "destination": "/services/social-media-pricing", "permanent": true },
    { "source": "/seo-cyprus", "destination": "/seo/cyprus", "permanent": true },
    { "source": "/seo-limassol", "destination": "/seo/limassol", "permanent": true },
    { "source": "/seo", "destination": "/services/seo", "permanent": true },
    { "source": "/seo-overview", "destination": "/services/seo", "permanent": true },
    { "source": "/seo-strategy", "destination": "/services/seo-strategy", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/careers", "destination": "/api/career-page?format=json&listing=1" },
    { "source": "/api/career-role", "destination": "/api/career-page?format=json" },
    { "source": "/llms.txt", "destination": "/api/llms" },
    { "source": "/faq", "destination": "/api/home-page?view=faq" },
    { "source": "/faq/:category", "destination": "/api/home-page?view=faq&category=:category" },
    { "source": "/contact/free-website-audit", "destination": "/api/home-page?view=audit&type=website" },
    { "source": "/contact/local-seo", "destination": "/api/home-page?view=audit&type=local-seo" },
    { "source": "/contact/free-social-media-audit", "destination": "/api/home-page?view=audit&type=social-media" },
    { "source": "/pt/", "destination": "/api/home-page?lang=pt-PT" },
    { "source": "/es/", "destination": "/api/home-page?lang=es" },
    { "source": "/el/", "destination": "/api/home-page?lang=el" },
    { "source": "/ru/", "destination": "/api/home-page?lang=ru" },
    { "source": "/he/", "destination": "/api/home-page?lang=he" },
    { "source": "/pt", "destination": "/api/home-page?lang=pt-PT" },
    { "source": "/es", "destination": "/api/home-page?lang=es" },
    { "source": "/el", "destination": "/api/home-page?lang=el" },
    { "source": "/ru", "destination": "/api/home-page?lang=ru" },
    { "source": "/he", "destination": "/api/home-page?lang=he" },
    { "source": "/pt/news", "destination": "/api/news-page?lang=pt-PT" },
    { "source": "/es/news", "destination": "/api/news-page?lang=es" },
    { "source": "/el/news", "destination": "/api/news-page?lang=el" },
    { "source": "/ru/news", "destination": "/api/news-page?lang=ru" },
    { "source": "/he/news", "destination": "/api/news-page?lang=he" },
    { "source": "/pt/news/page/:page", "destination": "/api/news-page?lang=pt-PT&page=:page" },
    { "source": "/es/news/page/:page", "destination": "/api/news-page?lang=es&page=:page" },
    { "source": "/el/news/page/:page", "destination": "/api/news-page?lang=el&page=:page" },
    { "source": "/ru/news/page/:page", "destination": "/api/news-page?lang=ru&page=:page" },
    { "source": "/he/news/page/:page", "destination": "/api/news-page?lang=he&page=:page" },
    { "source": "/pt/insights/:slug", "destination": "/api/article-page?lang=pt-PT&slug=:slug&section=insights" },
    { "source": "/es/insights/:slug", "destination": "/api/article-page?lang=es&slug=:slug&section=insights" },
    { "source": "/el/insights/:slug", "destination": "/api/article-page?lang=el&slug=:slug&section=insights" },
    { "source": "/ru/insights/:slug", "destination": "/api/article-page?lang=ru&slug=:slug&section=insights" },
    { "source": "/he/insights/:slug", "destination": "/api/article-page?lang=he&slug=:slug&section=insights" },
    { "source": "/pt/case-studies/:slug", "destination": "/api/article-page?lang=pt-PT&slug=:slug&section=case-studies" },
    { "source": "/es/case-studies/:slug", "destination": "/api/article-page?lang=es&slug=:slug&section=case-studies" },
    { "source": "/el/case-studies/:slug", "destination": "/api/article-page?lang=el&slug=:slug&section=case-studies" },
    { "source": "/ru/case-studies/:slug", "destination": "/api/article-page?lang=ru&slug=:slug&section=case-studies" },
    { "source": "/he/case-studies/:slug", "destination": "/api/article-page?lang=he&slug=:slug&section=case-studies" },
    { "source": "/pt/news/:slug", "destination": "/api/article-page?lang=pt-PT&slug=:slug&section=news" },
    { "source": "/es/news/:slug", "destination": "/api/article-page?lang=es&slug=:slug&section=news" },
    { "source": "/el/news/:slug", "destination": "/api/article-page?lang=el&slug=:slug&section=news" },
    { "source": "/ru/news/:slug", "destination": "/api/article-page?lang=ru&slug=:slug&section=news" },
    { "source": "/he/news/:slug", "destination": "/api/article-page?lang=he&slug=:slug&section=news" },
    { "source": "/pt/services/seo", "destination": "/api/home-page?view=seo&lang=pt-PT" },
    { "source": "/es/services/seo", "destination": "/api/home-page?view=seo&lang=es" },
    { "source": "/el/services/seo", "destination": "/api/home-page?view=seo&lang=el" },
    { "source": "/ru/services/seo", "destination": "/api/home-page?view=seo&lang=ru" },
    { "source": "/pt/:path*", "destination": "/_localized/pt/:path*" },
    { "source": "/es/:path*", "destination": "/_localized/es/:path*" },
    { "source": "/el/:path*", "destination": "/_localized/el/:path*" },
    { "source": "/ru/:path*", "destination": "/_localized/ru/:path*" },
    { "source": "/he/:path*", "destination": "/_localized/he/:path*" },
    { "source": "/", "destination": "/api/home-page" },
    { "source": "/news", "destination": "/api/news-page" },
    { "source": "/news/page/:page", "destination": "/api/news-page?page=:page" },
    { "source": "/careers", "destination": "/api/career-page?listing=1" },
    { "source": "/services/website", "destination": "/website-services" },
    { "source": "/services/website-development", "destination": "/website-development" },
    { "source": "/services/website-pricing", "destination": "/website-pricing" },
    { "source": "/services/free-website", "destination": "/free-website" },
    { "source": "/services/localization-and-translation", "destination": "/localization-and-translation" },
    { "source": "/services/social-media", "destination": "/social-media" },
    { "source": "/services/social-media-pricing", "destination": "/social-media-pricing" },
    { "source": "/services/seo", "destination": "/api/home-page?view=seo" },
    { "source": "/services/seo-strategy", "destination": "/seo-strategy" },
    { "source": "/seo/cyprus", "destination": "/seo-cyprus" },
    { "source": "/seo/limassol", "destination": "/seo-limassol" },
    { "source": "/sitemap", "destination": "/api/sitemap-page" },
    { "source": "/insights/:slug", "destination": "/api/article-page?slug=:slug&section=insights" },
    { "source": "/case-studies/:slug", "destination": "/api/article-page?slug=:slug&section=case-studies" },
    { "source": "/news/:slug", "destination": "/api/article-page?slug=:slug&section=news" },
    { "source": "/careers/:slug", "destination": "/api/career-page?slug=:slug" },
    { "source": "/career-role", "destination": "/api/career-page?legacy=1" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ]
}
